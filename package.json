{
  "name": "bluenote-webui",
  "version": "0.1.0",
  "description": "Local web UI for BlueNote.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@8.5.0",
  "engines": {
    "node": ">=16.14 <17 || >=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,cyan \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_ENV=test vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@lordierclaw/bluenote-core": "file:../bluenote-core",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.10.3"
  },
  "overrides": {
    "@testing-library/dom": "9.3.4",
    "node-releases": "2.0.14"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.2.2",
    "@testing-library/user-event": "14.4.3",
    "@types/node": "16.18.126",
    "@types/node-fetch": "2.6.13",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "globals": "13.24.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.14",
    "jsdom": "22.1.0",
    "tsx": "3.14.0",
    "node-fetch": "2.7.0",
    "typescript": "5.8.3",
    "vite": "4.5.14",
    "vitest": "0.34.6"
  }
}
