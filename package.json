{
  "name": "bluenote-webui",
  "version": "0.1.0",
  "description": "Local web UI for BlueNote.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,cyan \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_ENV=test vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@lordierclaw/bluenote-core": "file:../bluenote-core",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.10.3"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "18.19.112",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.14",
    "jsdom": "24.1.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "7.18.0",
    "vite": "5.4.21",
    "vitest": "1.6.0"
  }
}
